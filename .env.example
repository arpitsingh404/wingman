# ---------------------------------------------------------------------------
# Wingman configuration
# Copy this file to .env and fill in what you use.
# Never commit the real .env.
# ---------------------------------------------------------------------------

# Server
WINGMAN_HOST=127.0.0.1
WINGMAN_PORT=8200

# Model providers (set at least one)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Gmail (optional)
# OAuth client is configured in the UI; these are for the App Password fallback.
WINGMAN_GMAIL_USER=
WINGMAN_GMAIL_PASS=
WINGMAN_GMAIL_CLIENT_ID=
WINGMAN_GMAIL_CLIENT_SECRET=

# Telegram bot (optional)
WINGMAN_TELEGRAM_TOKEN=
WINGMAN_TELEGRAM_BOT=

# SSH / VPS (optional; can also be configured in the UI)
WINGMAN_SSH_PASSWORD=
